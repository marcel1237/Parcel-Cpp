QMainWindow, QDialog { background-color: #0f111a; }
QTabWidget::pane { border: 1px solid #1e1e30; top: -1px; background: #0f111a; }
QTabBar::tab { background: #161925; color: #888; padding: 10px 20px; border: 1px solid #1e1e30; border-bottom: none; border-top-left-radius: 4px; border-top-right-radius: 4px; margin-right: 2px; }
QTabBar::tab:selected { background: #0f111a; color: #00BFFF; border-top: 2px solid #00BFFF; font-weight: bold; }
QMenuBar { background: #161925; color: #ccc; border-bottom: 1px solid #1e1e30; }
QMenuBar::item:selected { background: #4285F4; color: white; }
QMenu { background: #161925; color: #ccc; border: 1px solid #1e1e30; }
QMenu::item:selected { background: #4285F4; color: white; }
QTreeWidget, QListWidget, QTextEdit { background-color: #161925; border: 1px solid #1e1e30; border-radius: 4px; color: #e0e0e0; }
QPushButton { background-color: #1e2136; color: white; border: 1px solid #4285F4; padding: 6px 15px; border-radius: 4px; }
QPushButton:hover { background-color: #4285F4; }
QLineEdit { background-color: #161925; border: 1px solid #1e1e30; padding: 4px; border-radius: 4px; color: #e0e0e0; }
QScrollBar:vertical { border: none; background: #0f111a; width: 10px; margin: 0px; }
QScrollBar::handle:vertical { background: #1e1e30; min-height: 20px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background: #4285F4; }
